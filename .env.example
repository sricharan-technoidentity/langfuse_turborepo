# Copy this file to .env (in the repo root) and fill in your keys.
# Anything left as <...> is treated as "not set". Without keys everything still runs
# (mock model, traces stay local).

# ──────────────────────────── LLM provider ────────────────────────────
# auto (default) = OpenAI if OPENAI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else the mock model
# Or force one: openai | anthropic | mock
LLM_PROVIDER="auto"

# OpenAI  — https://platform.openai.com/api-keys
OPENAI_API_KEY="<your-openai-api-key>"
OPENAI_MODEL="gpt-6-luna"
# Optional: any OpenAI-compatible endpoint (Azure OpenAI, OpenRouter, Groq, Ollama...)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Anthropic (Claude)  — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="<your-anthropic-api-key>"
ANTHROPIC_MODEL="claude-haiku-5-5"

# ──────────────────────────── Langfuse Cloud ────────────────────────────
# Langfuse Cloud -> your project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY="<your-langfuse-public-key>"
LANGFUSE_SECRET_KEY="<your-langfuse-secret-key>"

# EU region (default). US: https://us.cloud.langfuse.com  Japan: https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Shown as the "environment" filter in Langfuse (e.g. development, staging, production)
LANGFUSE_TRACING_ENVIRONMENT="development"

# Optional: release/version tag attached to every trace (e.g. a git SHA)
# LANGFUSE_RELEASE="local"

# ──────────────────────────── Other ────────────────────────────
# Simulated latency of the mock model, in milliseconds (0 = instant)
MOCK_LLM_LATENCY_MS="0"
