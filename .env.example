# Copy to packages/infra/.env (local dev/tests only; never commit it). Real environment variables win.
# Both infra packages (TS @repo/langfuse, Python repo-langfuse) read the same names.
# Anything left as <...> counts as "not set" -> tracing is skipped and Deck Forge works exactly as before.

# Langfuse Cloud -> your project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY="<your-langfuse-public-key>"
LANGFUSE_SECRET_KEY="<your-langfuse-secret-key>"

# This project is in the US region. EU: https://cloud.langfuse.com  Japan: https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

LANGFUSE_TRACING_ENVIRONMENT="development"
# LANGFUSE_RELEASE="local"

# NOTE: the Kiro Crew gateway does NOT pass LANGFUSE_* to app backends (minimal_env allowlist).
# For the installed app, put these lines in ~/.kiro/crew/apps/deck-forge/data/langfuse.env (chmod 600).
# See docs/BUILD-REPORT.md "Env mechanism".
