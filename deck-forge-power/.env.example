# All optional. Set these in the shell/OS environment that launches Kiro (the IDE does not read this file).
DECK_FORGE_OUT_DIR=
# Langfuse tracing + feedback turn on only when BOTH keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=kiro-ide
