# Langfuse settings, read by both infra packages (TypeScript @repo/langfuse, Python repo-langfuse).
# For local runs and tests: copy this file to packages/infra/.env and fill it in. Never commit .env.
# Real environment variables win over this file. Left empty, tracing is skipped and the app still works.
#
# For the app installed in Kiro Crew, put the same three lines in
# ~/.kiro/crew/apps/deck-forge/data/langfuse.env instead (run `pnpm app:keys`).

# Langfuse project -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY="<your-langfuse-public-key>"
LANGFUSE_SECRET_KEY="<your-langfuse-secret-key>"

# US region. EU: https://cloud.langfuse.com   Japan: https://jp.cloud.langfuse.com
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# Shown as the "environment" filter in Langfuse (development, staging, production)
LANGFUSE_TRACING_ENVIRONMENT="development"

# Optional: release tag added to every trace (for example a git SHA)
# LANGFUSE_RELEASE=""
