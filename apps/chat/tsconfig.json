{
  "extends": "@repo/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "src/server",
    "outDir": "dist/server",
    "declaration": false,
    "declarationMap": false,
    // The dev server runs src/server/*.ts with Node's type stripping, which needs ".ts" imports.
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/server"]
}
